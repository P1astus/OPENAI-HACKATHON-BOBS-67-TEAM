# Copy to .env.local (git-ignored) and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
# Everything is optional for local dev: without keys the app falls back (see notes).

# OpenAI triage and optional web search. Without a key, new reports go to a human via
# the emergency rules or a labelled keyword guess. A single-trade clarification can still match.
# Triage and web search use gpt-5.5 when OPENAI_MODEL is empty or unset.
# For the optional OPENAI_BASE_URL used by the recording fixture, see scripts/video/README.md.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol

# Voice availability for phone-booking partners, with non-partners as a matching fallback.
# If any of these three variables is unset, calls are simulated and labelled in the timeline.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Demo only: route every outbound call to this number (the teammate playing the company).
VOICE_TEST_TO_NUMBER=
# Shared secret the ElevenLabs tool sends as the x-webhook-secret header to /api/agent/voice-result.
VOICE_WEBHOOK_SECRET=

# Shared state on Vercel. Without these, state lives in memory (local dev only).
# Supports UPSTASH_REDIS_REST_* or KV_REST_API_* names. Set a complete pair.
# When using KV_REST_API_*, remove the UPSTASH_REDIS_REST_* entries from .env.local.
# An empty primary entry overrides its alias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional booking and invoice status webhooks through n8n. Unset = no webhooks.
N8N_WEBHOOK_URL=

# NEXT_PUBLIC_USE_MOCKS=1  # Public UI flag for lib/mock.ts fixtures. Leave unset to use the app API.
