# Copy to .env.local (git-ignored) and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
# Everything is optional for local dev: without keys the app falls back (see notes).

# AI triage. Without a key every new ticket goes to the property manager (keyword guess only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Voice call to non-partner companies. Without these, the call is simulated and labelled as such.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Demo only: route every outbound call to this number (the teammate playing the company).
VOICE_TEST_TO_NUMBER=
# Shared secret the ElevenLabs tool sends as the x-webhook-secret header to /api/agent/voice-result.
VOICE_WEBHOOK_SECRET=

# Shared state on Vercel. Without these, state lives in memory (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional status emails through n8n. Unset = no messages.
N8N_WEBHOOK_URL=

# NEXT_PUBLIC_USE_MOCKS=1  # UI only: use lib/mock.ts fixtures (not a secret)
